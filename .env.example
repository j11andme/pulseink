# Shared local profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
PULSEINK_BUSINESS_ZONE=Asia/Shanghai

# MySQL
MYSQL_DATABASE=pulseink
MYSQL_USER=pulseink
MYSQL_PASSWORD=pulseink_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PORT=3307
MYSQL_URL=jdbc:mysql://localhost:3307/pulseink?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

# Channel Sandbox database (same local MySQL instance, isolated database and account)
SANDBOX_MYSQL_DATABASE=pulseink_channel
SANDBOX_MYSQL_USER=pulseink_channel
SANDBOX_MYSQL_PASSWORD=pulseink_channel_dev
SANDBOX_MYSQL_URL=jdbc:mysql://localhost:3307/pulseink_channel?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

# Redis (prepared for run lease and short-lived memory cache)
PULSEINK_REDIS_PORT=6380
PULSEINK_REDIS_URL=redis://localhost:6380/0

# Elasticsearch
PULSEINK_ELASTICSEARCH_PORT=9201
PULSEINK_ELASTICSEARCH_URL=http://localhost:9201

# Kafka (host applications use localhost; Compose services use kafka:29092)
PULSEINK_KAFKA_PORT=9094
PULSEINK_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
PULSEINK_KAFKA_FEEDBACK_TOPIC=pulseink.feedback.raw.v1
PULSEINK_KAFKA_FEEDBACK_DLT_TOPIC=pulseink.feedback.raw.v1-dlt
PULSEINK_KAFKA_FEEDBACK_CONSUMER_GROUP=pulseink-feedback-v1

# Idempotent publishing and feedback workers (public-safe defaults)
PULSEINK_CHANNEL_CONNECT_TIMEOUT=3s
PULSEINK_CHANNEL_READ_TIMEOUT=10s
PULSEINK_PUBLICATION_WORKER_ENABLED=true
PULSEINK_PUBLICATION_POLL_DELAY=1s
PULSEINK_PUBLICATION_BATCH_SIZE=20
PULSEINK_PUBLICATION_MAX_ATTEMPTS=3
PULSEINK_PUBLICATION_RETRY_DELAY=5s
PULSEINK_OUTBOX_POLL_DELAY=1s
PULSEINK_OUTBOX_BATCH_SIZE=50
PULSEINK_OUTBOX_MAX_ATTEMPTS=3
PULSEINK_OUTBOX_RETRY_DELAY=5s
PULSEINK_OUTBOX_PUBLISHER_ENABLED=true
PULSEINK_FEEDBACK_CONSUMER_MAX_ATTEMPTS=3
PULSEINK_FEEDBACK_CONSUMER_ENABLED=true

# Memory and multi-instance run lease (public-safe defaults)
PULSEINK_MEMORY_INDEX_ALIAS=pulseink-memory-insight-active
PULSEINK_MEMORY_APPROVED_TOP_K=3
PULSEINK_MEMORY_MAX_SEARCH_TOP_K=10
PULSEINK_MEMORY_CONTEXT_MAX_CODE_POINTS=12000
PULSEINK_RUN_MEMORY_TTL=30m
PULSEINK_MEMORY_INDEX_WORKER_ENABLED=true
PULSEINK_MEMORY_INDEX_WORKER_DELAY=2s
PULSEINK_MEMORY_INDEX_MAX_ATTEMPTS=3
PULSEINK_RUN_LEASE_ENABLED=true
PULSEINK_RUN_LEASE_TTL=30s
PULSEINK_RUN_LEASE_RENEW_INTERVAL=10s

# Knowledge ingestion storage and limits (public-safe defaults)
PULSEINK_KNOWLEDGE_STORAGE_ROOT=./data/knowledge
PULSEINK_KNOWLEDGE_MAX_FILE_BYTES=10485760
PULSEINK_KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
PULSEINK_KNOWLEDGE_MAX_CHUNK_CODE_POINTS=1000
PULSEINK_KNOWLEDGE_CHUNK_OVERLAP=120
PULSEINK_KNOWLEDGE_MAX_CHUNKS=2000
PULSEINK_KNOWLEDGE_STALE_JOB_TIMEOUT=10m
PULSEINK_KNOWLEDGE_INDEX_ALIAS=pulseink-knowledge-active
PULSEINK_KNOWLEDGE_BRANCH_LIMIT=20
PULSEINK_KNOWLEDGE_RRF_CONSTANT=60
PULSEINK_KNOWLEDGE_SNIPPET_MAX_CODE_POINTS=500

# Orchestration limits (public-safe defaults)
PULSEINK_ORCHESTRATION_MAX_TASKS=12
PULSEINK_ORCHESTRATION_MAX_PARALLEL_READ_TASKS=3
PULSEINK_ORCHESTRATION_MAX_CONTEXT_CODE_POINTS=12000
PULSEINK_ORCHESTRATION_PLANNER_MAX_MODEL_CALLS=3

# Embedding provider: fake | openai-compatible (independent from chat model config)
PULSEINK_EMBEDDING_PROVIDER=fake
PULSEINK_EMBEDDING_BASE_URL=
PULSEINK_EMBEDDING_API_KEY=
PULSEINK_EMBEDDING_MODEL=
PULSEINK_EMBEDDING_DIMENSIONS=64
PULSEINK_EMBEDDING_DIMENSION_FIELD=dimensions
PULSEINK_EMBEDDING_BATCH_SIZE=16
PULSEINK_EMBEDDING_TIMEOUT=30s

# Local-only authentication defaults
PULSEINK_JWT_SECRET=pulseink-local-only-jwt-secret-2026
PULSEINK_DEMO_PASSWORD=pulseink-demo

# Model provider: fake | ark | zhipu
# Ark requires a model ID or Endpoint ID from the Volcengine Ark console.
# Zhipu uses its own API key and public model code, for example glm-5.2.
# PULSEINK_MODEL_FALLBACK_PROVIDER is optional; when configured it must differ from
# PULSEINK_MODEL_PROVIDER and carry a full public configuration below.
PULSEINK_MODEL_PROVIDER=fake
PULSEINK_MODEL_FALLBACK_PROVIDER=
PULSEINK_MODEL_REQUEST_TIMEOUT=180s
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
PULSEINK_AGENT_MAX_OUTPUT_TOKENS_PER_CALL=8192
PULSEINK_AGENT_COMPLETION_TIMEOUT=180s
PULSEINK_EVALUATION_ROOT=../evals
PULSEINK_EVALUATION_REPORT_ROOT=../evals/reports
PULSEINK_EVALUATION_JUDGE_TIMEOUT=180s
PULSEINK_EVALUATION_MAX_OUTPUT_TOKENS_PER_CALL=8192
PULSEINK_EVALUATION_COMPLETION_TIMEOUT=180s

# Development applications
FRONTEND_PORT=5173
PULSEINK_BACKEND_URL=http://localhost:8080
SANDBOX_PORT=8090
PULSEINK_CHANNEL_BASE_URL=http://localhost:8090/channel-api/v1
